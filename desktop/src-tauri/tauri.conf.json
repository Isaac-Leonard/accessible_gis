{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build&npm run build --prefix external-touch-device",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
	"resources":{
	    "../data": "data",
	    "../external-touch-device/dist": "external-touch-device",
	    "../../scripts": "scripts",
	    "../../esc-50": "esc-50"
	},
    "active": true,
    "targets": "all",
	"icon": ["icons/icon.icns", "icons/icon.ico"]
  },
  "productName": "accessible_gis",
  "version": "0.0.0",
  "identifier": "accessible-gis",
  "plugins": {},
  "app": {
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: https://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    },
    "windows": [
      {
        "title": "accessible_gis",
        "width": 800,
        "height": 600
      }
    ]
  }
}
